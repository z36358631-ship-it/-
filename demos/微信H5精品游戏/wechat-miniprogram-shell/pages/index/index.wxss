.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 56rpx 30rpx calc(44rpx + env(safe-area-inset-bottom));
}

.hero {
  display: flex;
  flex-direction: column;
  margin-bottom: 34rpx;
}

.eyebrow {
  margin-bottom: 12rpx;
  color: #8feaff;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: .2em;
}

.title {
  color: #fff;
  font-size: 58rpx;
  font-weight: 800;
  letter-spacing: -.03em;
}

.subtitle {
  margin-top: 12rpx;
  color: #aab2ca;
  font-size: 25rpx;
}

.game-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.game-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  width: 100%;
  min-height: 270rpx;
  padding: 28rpx;
  color: #fff;
  text-align: left;
  border: 1rpx solid rgba(255, 255, 255, .12);
  border-radius: 32rpx;
  background: rgba(19, 24, 43, .92);
  box-shadow: 0 22rpx 50rpx rgba(0, 0, 0, .24);
}

.game-card::after {
  border: 0;
}

.game-card.cyan {
  background: linear-gradient(145deg, rgba(31, 86, 110, .72), rgba(15, 21, 42, .96) 58%);
}

.game-card.gold {
  background: linear-gradient(145deg, rgba(111, 78, 31, .72), rgba(23, 25, 42, .96) 58%);
}

.game-card.violet {
  background: linear-gradient(145deg, rgba(80, 44, 119, .74), rgba(20, 15, 35, .97) 58%);
}

.card-head,
.action {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order {
  color: rgba(255, 255, 255, .62);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: .18em;
}

.genre {
  color: #d9def1;
  font-size: 22rpx;
}

.game-title {
  margin-top: 26rpx;
  font-size: 42rpx;
  font-weight: 800;
}

.summary {
  margin-top: 10rpx;
  color: #c9cfe1;
  font-size: 25rpx;
  line-height: 1.55;
}

.action {
  margin-top: auto;
  padding-top: 24rpx;
  color: #fff3bd;
  font-size: 24rpx;
  font-weight: 700;
}

.note {
  display: block;
  margin-top: 30rpx;
  color: #7e879f;
  font-size: 21rpx;
  line-height: 1.5;
  text-align: center;
}
