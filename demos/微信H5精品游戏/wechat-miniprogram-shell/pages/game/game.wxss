.setup {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  min-height: 100vh;
  padding: 44rpx 32rpx;
}

.setup-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  width: 100%;
  padding: 42rpx 34rpx;
  border: 1rpx solid rgba(255, 255, 255, .12);
  border-radius: 34rpx;
  background: rgba(18, 23, 41, .96);
}

.eyebrow {
  color: #ffcc72;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: .18em;
}

.title {
  margin-top: 20rpx;
  color: #fff;
  font-size: 40rpx;
  font-weight: 800;
}

.copy {
  margin-top: 18rpx;
  color: #bdc5d9;
  font-size: 26rpx;
  line-height: 1.65;
}

.back {
  margin-top: 34rpx;
  min-height: 92rpx;
  color: #171107;
  font-size: 27rpx;
  font-weight: 800;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffe08a, #f2a848);
}

.back::after {
  border: 0;
}
