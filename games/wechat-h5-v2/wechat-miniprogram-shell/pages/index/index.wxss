.page {
  min-height: 100vh;
  padding: 64rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: radial-gradient(circle at top, #18324c, #07101d 58%);
}

.hero {
  display: flex;
  flex-direction: column;
  margin-bottom: 40rpx;
}

.eyebrow {
  color: #85e9ff;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.title {
  margin-top: 20rpx;
  font-size: 72rpx;
  font-weight: 900;
}

.subtitle,
.warning {
  margin-top: 18rpx;
  color: #b9c9d8;
  font-size: 26rpx;
  line-height: 1.6;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.card {
  display: flex;
  min-height: 176rpx;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 32rpx;
  padding: 28rpx;
  background: rgba(18, 35, 54, 0.92);
  color: #fff;
  text-align: left;
}

.card-title {
  font-size: 38rpx;
  font-weight: 800;
}

.card-copy {
  margin-top: 12rpx;
  color: #b8cadb;
  font-size: 25rpx;
}
